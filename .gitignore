node_modules/
dist/

# Blog content is a separate repo (tamtree-ai/blog), fetched at build time
# by scripts/content/sync.mjs rather than pinned as a submodule — a submodule
# records a SHA, so publishing a post would need a pointer bump committed here.
# The whole point is that it does not.
#
# Anchored to root: an unanchored `content/` also matches scripts/content/ and
# src/content/, which silently kept scripts/content/sync.mjs — the script this
# comment is about — out of every commit ever made.
/content/

.astro/
.vercel/
shots/
reports/
.DS_Store
.env
.env.production
design/reference/
design/diff/
.vercel
