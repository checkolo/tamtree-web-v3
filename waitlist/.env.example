# Copy to .env on the host (never commit it). docs/waitlist.md explains each.
# The API key must be Full access: Sending access cannot create contacts.
RESEND_API_KEY=re_...
WAITLIST_FROM=Tamtree <waitlist@tamtree.io>
WAITLIST_NOTIFY_TO=you@example.com
SITE_ORIGIN=https://www.tamtree.io
# The app stack's Docker network, which Caddy is on. Compose reads it from this file.
CADDY_NETWORK=docker_default
# Optional — add the contact to a segment, and map the opt-ins to topics.
RESEND_SEGMENT_ID=
RESEND_TOPIC_LAUNCH_NEWS=
RESEND_TOPIC_EARLY_ACCESS=

# Optional — bot cost and ceiling (docs/waitlist.md, "Abuse").
WAITLIST_POW_BITS=15
WAITLIST_HOURLY_CAP=100
