---
/**
 * The waitlist form (T2.2), posting to our own `/api/waitlist` (waitlist/server.mjs,
 * contract in docs/waitlist.md).
 *
 * The one place on the site that needs script (owner's call, 2026-10-28): the
 * script computes a proof-of-work stamp that keeps bots out, and a POST without
 * one is refused. Without JS the <noscript> says so and offers the contact
 * email instead; a POST made anyway lands on /waitlist/sorry/. Nothing else on
 * the page depends on this — it is still a real form with a real action.
 *
 * The script sends the fields with `Accept: application/json` and renders the
 * deck's own message in place — and, because it can read the response, says
 * "you're on the list" only when the endpoint said so. While the stamp is
 * computed and the request is out, the button spins and says "Joining…"; a
 * success swaps the form for a panel that can bring it back for another address.
 */
import { legal } from '../data/legal';

interface Tag {
  value: string;
  label: string;
  checked?: boolean;
}

interface Props {
  id?: string;
  size?: 'md' | 'lg' | 'xl';
  cta?: string;
  /** Optional opt-ins, submitted as additional `tag` fields. */
  tags?: Tag[];
  class?: string;
}
const {
  id = 'waitlist',
  size = 'lg',
  cta = 'Get early access',
  tags = [],
  class: className,
} = Astro.props;
const inputId = `${id}-email`;
---

{/* One flex item to whatever row hosts it: without the wrapper, the message
    and <noscript> become siblings in the hero's row and sit beside the form. */}
<div class="wl-wrap">
<form
  class:list={['wl', `wl--${size}`, className]}
  id={id}
  action="/api/waitlist"
  method="post"
  autocomplete="off"
>
  <div class="wl__row">
    <label class="visually-hidden" for={inputId}>Work email</label>
    <input
      class="wl__input"
      id={inputId}
      type="email"
      name="email"
      placeholder="you@work.com"
      autocomplete="email"
      required
    />
    <input type="hidden" name="tag" value="waitlist" />
    {/* Honeypot — off-screen and out of the tab order, so only a bot fills it. */}
    <label class="wl__trap" aria-hidden="true">
      Company <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
    <button class="btn btn--primary btn--sm wl__submit" type="submit">
      <span class="wl__spin" aria-hidden="true"></span>
      <span class="wl__label">{cta}</span>
    </button>
  </div>

  {
    tags.length > 0 && (
      <fieldset class="wl__tags">
        <legend class="visually-hidden">What to send you</legend>
        {tags.map((tag) => (
          <label class="wl__tag">
            <input type="checkbox" name="tag" value={tag.value} checked={tag.checked} />
            <span class="wl__box" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M20 6L9 17l-5-5" />
              </svg>
            </span>
            {tag.label}
          </label>
        ))}
      </fieldset>
    )
  }
</form>

<noscript>
  <p class="wl__noscript">
    The waitlist needs JavaScript on, to keep bots out. Or email{' '}
    <a href={`mailto:${legal.contactEmail}`}>{legal.contactEmail}</a> and we'll add you.
  </p>
</noscript>

<p class="wl__msg" id={`${id}-msg`} role="status" aria-live="polite" hidden></p>

<div class="wl__done" id={`${id}-done`} role="status" tabindex="-1" hidden>
  <span class="wl__done-icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d="M20 6L9 17l-5-5" />
    </svg>
  </span>
  <div class="wl__done-body">
    <p class="wl__done-title">You're on the list.</p>
    <p class="wl__done-text">We'll write to <strong class="wl__done-email"></strong> before launch.</p>
    <button class="wl__again" type="button">Add another email</button>
  </div>
</div>
</div>

<script>
  // Must match WAITLIST_POW_BITS in waitlist/server.mjs (default 15).
  const POW_BITS = 15;

  const FAILED: Record<string, string> = {
    email: "That doesn't look like an email address — check it and try again.",
    busy: 'Too many signups right now. Give it a few minutes and try again.',
  };
  const FALLBACK = "Something went wrong on our side and you're not on the list yet. Please try again shortly.";

  function zeroBits(bytes: Uint8Array): number {
    let bits = 0;
    for (const byte of bytes) {
      if (byte === 0) {
        bits += 8;
        continue;
      }
      return bits + Math.clz32(byte) - 24;
    }
    return bits;
  }

  /** The nonce for sha256(`${email}:${ts}:${nonce}`) — waitlist/server.mjs checkStamp. */
  async function stamp(email: string, ts: number): Promise<number> {
    const enc = new TextEncoder();
    for (let nonce = 0; ; nonce++) {
      const digest = await crypto.subtle.digest('SHA-256', enc.encode(`${email}:${ts}:${nonce}`));
      if (zeroBits(new Uint8Array(digest)) >= POW_BITS) return nonce;
    }
  }

  async function send(form: HTMLFormElement, ts: number) {
    const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
    // Normalised exactly as the server does, or the hash would not match.
    const email = (body.get('email') ?? '').trim().toLowerCase();
    body.set('pow_ts', String(ts));
    body.set('pow_nonce', String(await stamp(email, ts)));
    const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body });
    const data = await res.json().catch(() => ({}));
    return { ok: res.ok && data.ok === true, error: String(data.error ?? ''), now: Number(data.now) };
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('.wl')) {
    const msg = document.getElementById(`${form.id}-msg`);
    const done = document.getElementById(`${form.id}-done`);
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = submit?.querySelector<HTMLElement>('.wl__label');
    const cta = label?.textContent ?? '';
    if (!msg || !done) continue;

    const busy = (on: boolean) => {
      if (!submit) return;
      submit.disabled = on;
      submit.setAttribute('aria-busy', String(on));
      submit.classList.toggle('wl__submit--busy', on);
      if (label) label.textContent = on ? 'Joining…' : cta;
    };

    // Firefox restores a disabled button on reload and bfcache restores the
    // whole page as it was left — either way the button must come back live.
    window.addEventListener('pageshow', () => {
      if (form.hidden) return;
      busy(false);
    });

    done.querySelector('.wl__again')?.addEventListener('click', () => {
      form.reset();
      done.hidden = true;
      msg.hidden = true;
      form.hidden = false;
      busy(false);
      form.querySelector<HTMLInputElement>('input[type="email"]')?.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit?.disabled) return;
      busy(true);
      msg.hidden = true;
      let result = { ok: false, error: '', now: NaN };
      try {
        result = await send(form, Math.floor(Date.now() / 1000));
        // This device's clock is off by minutes: stamp again against the server's.
        if (result.error === 'clock' && Number.isFinite(result.now)) result = await send(form, result.now);
      } catch {
        // Offline, or the endpoint is down: the fallback copy covers both.
      }
      busy(false);
      if (result.ok) {
        const email = new FormData(form).get('email');
        const slot = done.querySelector('.wl__done-email');
        if (slot) slot.textContent = String(email ?? '').trim();
        form.hidden = true;
        done.hidden = false;
        done.focus();
        return;
      }
      msg.textContent = FAILED[result.error] ?? FALLBACK;
      msg.hidden = false;
    });
  }
</script>

<style>
  /* The pill lives on .wl__row, not on the form: the xl variant carries opt-in
     checkboxes under it, and a fieldset inside the pill would be a fieldset
     inside a text field as far as the eye is concerned. The md/lg forms have a
     single row, so this is visually identical for them. */
  .wl {
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: max-content;
    max-width: 100%;
  }

  /* `display: flex` above outranks the UA's `[hidden]` rule, so without this
     a "hidden" form stayed on screen after a signup with its button dead. */
  .wl[hidden],
  .wl__done[hidden] { display: none; }

  .wl__row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 0 8px 0 22px;
    border-radius: var(--r-pill);
    background: var(--field-bg);
    border: 1px solid var(--line-2);
    box-shadow: 0 4px 16px -6px rgba(15, 23, 42, 0.14);
  }

  .wl--lg .wl__row { height: 60px; }
  .wl--md .wl__row { height: 52px; }

  /* The finale's field is the page's last word, so it is wider, taller and lit
     from behind rather than merely bordered. */
  .wl--xl { width: 620px; }

  .wl--xl .wl__row {
    height: 66px;
    padding-left: 24px;
    box-shadow: 0 0 60px -20px color-mix(in srgb, var(--brand) 60%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .wl__input {
    width: 216px;
    max-width: 100%;
    height: 44px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font-family: var(--body);
    font-size: 16px;
  }

  .wl--xl .wl__input {
    flex: 1;
    width: auto;
    height: 48px;
    font-size: 17px;
  }

  .wl__input::placeholder {
    color: var(--ink-3);
  }

  .wl--xl .wl__submit { height: 50px; }

  .wl__submit--busy { cursor: progress; }

  .wl__submit:disabled { transform: none; }

  .wl__spin {
    display: none;
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    animation: wl-spin 0.7s linear infinite;
  }

  .wl__submit--busy .wl__spin { display: block; }

  @keyframes wl-spin {
    to { transform: rotate(360deg); }
  }

  /* The success panel takes the form's place, so it is sized like it and
     reads as the outcome of the action rather than a footnote under it. */
  .wl__done {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    min-width: min(420px, 100%);
    padding: 18px 22px;
    border-radius: var(--r-xl);
    background: color-mix(in srgb, var(--good) 12%, var(--field-bg));
    border: 1px solid color-mix(in srgb, var(--good) 45%, transparent);
    box-shadow: 0 8px 28px -12px color-mix(in srgb, var(--good) 55%, transparent);
    text-align: left;
    outline: none;
    animation: wl-pop 0.32s var(--ease) both;
  }

  .wl__done-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--good);
    color: #ffffff;
  }

  .wl__done-body p { margin: 0; }

  .wl__done-title {
    font-family: var(--body);
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
  }

  .wl__done-body .wl__done-text {
    margin-top: 4px;
    font-size: 15px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .wl__done-email { color: var(--good-ink); }

  .wl__again {
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .wl__again:hover { color: var(--ink); }

  .wl__again:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  @keyframes wl-pop {
    from { opacity: 0; transform: translateY(6px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .wl__tags {
    display: flex;
    justify-content: center;
    gap: 26px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .wl__tag {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--ink-3);
    cursor: pointer;
  }

  /* The native box is kept and hidden rather than replaced: it is what makes
     the label clickable, the checkbox focusable and the state announced. The
     painted box follows it with :checked and the focus ring follows :focus-visible,
     so nothing is reimplemented except the paint. */
  .wl__tag input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .wl__box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--ink) 3%, transparent);
    color: transparent;
  }

  .wl__tag input:checked + .wl__box {
    border-color: var(--brand);
    background: var(--brand);
    color: #160a02;
  }

  .wl__tag:has(input:checked) { color: var(--ink-2); }

  .wl__tag input:focus-visible + .wl__box {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .wl-wrap {
    display: flex;
    flex-direction: column;
    max-width: 100%;
  }

  /* `width: 0; min-width: 100%` keeps a long message from widening the wrapper:
     it wraps at the form's width instead of setting it. */
  .wl__msg,
  .wl__noscript {
    width: 0;
    min-width: 100%;
  }

  .wl__msg {
    margin-top: 14px;
    text-align: center;
    font-size: 16px;
    color: var(--danger-ink);
  }

  .wl__noscript {
    margin-top: 14px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .wl__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 700px) {
    .wl-wrap,
    .wl { width: 100%; }

    /* `.wl--lg .wl__row` above is (0,2,0); a media query adds no specificity,
       so a bare `.wl__row` here loses to it and the stacked rows keep the
       desktop 60px/52px height — which crushes the submit button to a sliver.
       The size selectors are repeated so the stacked height actually wins. */
    .wl__row,
    .wl--lg .wl__row,
    .wl--md .wl__row {
      height: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      padding: 10px;
      border-radius: var(--r-xl);
    }

    .wl__input {
      width: 100%;
      height: 40px;
      padding-inline: 12px;
    }

    .wl__row :global(.btn) {
      width: 100%;
      flex: none;
    }

    /* The finale keeps its field a pill on mobile and drops the button below
       it, which is what the mobile artboard draws — the compact treatment above
       is for the hero's form, where the field is one item in a stack. */
    .wl--xl { width: 100%; gap: 22px; }

    .wl--xl .wl__row {
      height: auto;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      gap: 11px;
    }

    .wl--xl .wl__input {
      height: 56px;
      padding-inline: 20px;
      border-radius: var(--r-pill);
      background: var(--field-bg);
      border: 1px solid var(--line-2);
      box-shadow: 0 0 50px -18px color-mix(in srgb, var(--brand) 60%, transparent),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
      font-size: 16.5px;
    }

    .wl--xl .wl__submit { height: 54px; }

    .wl__tags { gap: 18px; }

    .wl__tag { gap: 8px; font-size: 14px; }

    .wl__box { width: 19px; height: 19px; }
  }
</style>
