---
import Mark from './Mark.astro';
import Button from './Button.astro';

/**
 * Ported semantically from the artboards (C3). The mock draws three bare
 * anchors in a flex row; navigation links are a LIST, and saying so costs zero
 * pixels — `list-style:none` and `display:flex` render exactly the artboard.
 *
 * The mobile artboard keeps the mark and the CTA and moves the two links
 * behind a menu button. Same DOM in both: the list is always present and the
 * button is a disclosure for it, so nothing is duplicated per breakpoint.
 */
const links = [
  { href: '/product/', label: 'Product' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/blog/', label: 'Writing' },
];

/**
 * `aria-current="page"` on the section you are in. `startsWith` rather than
 * equality because /blog/a-post/ and /blog/category/engineering/ are both
 * inside Writing, and a nav that goes blank the moment you open a post is
 * telling the reader they have left the section they are reading.
 */
const here = Astro.url.pathname;
const isCurrent = (href: string) => here === href || here.startsWith(href);
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__home" aria-label="Tamtree — home">
      <Mark size={26} />
    </a>

    <button
      type="button"
      class="nav__menu"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>

    <nav class="nav__nav" aria-label="Main">
      <ul class="nav__list" id="nav-links">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href="/#waitlist" size="sm" class="nav__cta">Get early access</Button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav__menu');
  const list = document.getElementById('nav-links');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    list?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--page) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav__home:hover {
    color: inherit;
  }

  .nav__nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__list a {
    font-size: 15px;
    color: var(--ink-2);
  }

  .nav__list a:hover {
    color: var(--brand-ink);
  }

  /* Weight as well as colour, so the current section is not carried by hue
     alone — the same rule the category filter follows (C3). */
  .nav__list a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .nav__menu {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    background: var(--chip-bg);
    color: var(--ink-2);
    cursor: pointer;
  }

  /* The mobile artboard's layout, not a shrink of the desktop one (V2). */
  @media (max-width: 700px) {
    .nav__inner {
      height: 60px;
      gap: 10px;
    }

    .nav__menu {
      display: inline-flex;
      order: 3;
    }

    .nav__nav {
      gap: 10px;
    }

    .nav__list {
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 16px;
      background: var(--page);
      border-bottom: 1px solid var(--line);
      display: none;
    }

    .nav__list.is-open {
      display: flex;
    }

    .nav__list li a {
      display: block;
      padding: 12px 0;
      font-size: 17px;
    }
  }
</style>
