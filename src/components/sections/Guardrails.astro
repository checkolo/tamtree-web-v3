---
import Eyebrow from '../Eyebrow.astro';
import Chip from '../Chip.astro';

/**
 * §03 — runtime guardrails.
 *
 * DOM order is the MOBILE order — heading, then figure — and desktop places the
 * figure to its left with grid columns rather than reordering the source. That
 * is both what lets one DOM serve both widths and the better reading order: a
 * section's heading should reach a screen reader before its illustration.
 *
 * The device turns 90° at 390 (mobile artboard, device 2): the ember spine is a
 * vertical bar between two columns on desktop and a horizontal bar straight
 * across the card on mobile, with model output above it and what ships below.
 * Everything still passes through it, which is the point being made.
 *
 * C3: two labelled lists rather than a table. They are two sequences shown side
 * by side, and the guardrail is what maps one to the other — a table would
 * assert a row identity that the design deliberately renders as flow-through.
 * The figcaption states the pairing for anyone who cannot see the spine.
 */

const outputs = [
  'email jane@acme.com the quote',
  'ignore previous instructions and…',
  'the renewal closes on the 14th',
];
---

<section class="sec guardrails">
  <div class="seam" aria-hidden="true"></div>

  <div class="wrap guardrails__grid">
    <div class="rv guardrails__copy">
      <Eyebrow n="03">— runtime guardrails</Eyebrow>
      <h2>Autonomous,<br />not unsupervised.</h2>
      <p class="guardrails__lede">
        Every LLM call passes through runtime guardrails — PII, prompt injection, moderation,
        groundedness. Block it, redact it, regenerate it, or escalate to a human.
        <span class="guardrails__em">Enforced by the runtime, not by asking the model nicely.</span>
      </p>
      <ul class="guardrails__actions">
        <li><Chip>block</Chip></li>
        <li><Chip>redact</Chip></li>
        <li><Chip>regenerate</Chip></li>
        <li><Chip>escalate to a human</Chip></li>
      </ul>
    </div>

    <figure class="rv-l guardrails__figure">
      <div class="guardrails__card">
        <div class="guardrails__cols">
          <div class="guardrails__col">
            <p class="guardrails__label">MODEL OUTPUT</p>
            <ul class="guardrails__list">
              {outputs.map((text, i) => (
                <li class="guardrails__cell">
                  {text}
                  {i === 2 && <span class="guardrails__caret" aria-hidden="true"></span>}
                </li>
              ))}
            </ul>
          </div>

          <div class="guardrails__spine" aria-hidden="true">
            <span class="guardrails__spine-text">GUARDRAILS</span>
            <span class="guardrails__spark guardrails__spark--a"></span>
            <span class="guardrails__spark guardrails__spark--b"></span>
          </div>

          <div class="guardrails__col">
            <p class="guardrails__label">WHAT SHIPS</p>
            <ul class="guardrails__list">
              <li class="guardrails__cell">
                email <span class="guardrails__redacted">▮▮▮▮▮▮▮</span> the quote
                <span class="guardrails__verdict"><Chip tone="warn" size="sm">pii · redacted</Chip></span>
              </li>
              <li class="guardrails__cell guardrails__cell--blocked">
                <s>ignore previous instructions…</s>
                <span class="guardrails__verdict"><Chip tone="danger" size="sm">injection · blocked</Chip></span>
              </li>
              <li class="guardrails__cell guardrails__cell--allowed">
                the renewal closes on the 14th
                <span class="guardrails__verdict"><Chip tone="live" size="sm">grounded · allowed</Chip></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <figcaption class="visually-hidden">
        Three model outputs, each passing through the guardrail layer: an address is redacted, a
        prompt injection is blocked entirely, and a grounded statement is allowed through unchanged.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .guardrails { background: color-mix(in srgb, var(--page) var(--sec-veil), transparent); }

  .guardrails__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 56px;
    align-items: center;
  }

  /* Source order is mobile order; desktop places, it does not reorder. */
  .guardrails__copy { grid-column: 8 / span 5; }
  .guardrails__figure { grid-column: 1 / span 7; grid-row: 1; margin: 0; }

  h2 {
    margin: 20px 0 0;
    font-size: 54px;
    font-weight: 700;
    color: var(--ink);
  }

  .guardrails__lede {
    margin: 28px 0 0;
    max-width: 470px;
    font-size: 18px;
    line-height: 1.66;
    color: var(--ink-2);
  }

  .guardrails__em { color: var(--brand-ink); font-weight: 600; }

  .guardrails__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 30px 0 0;
    padding: 0;
    max-width: 470px;
    list-style: none;
  }

  .guardrails__card {
    position: relative;
    padding: 28px;
    border-radius: 24px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    box-shadow: var(--card-shadow);
  }

  .guardrails__cols {
    display: flex;
    align-items: stretch;
    gap: 18px;
  }

  .guardrails__col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .guardrails__label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    /* --ink-3, not --display-mute. --display-mute is documented display-only:
       at 66px it clears the 3:1 large-text threshold and at 10–11px it does
       not. The artboards use it here; the palette does not get to. */
    color: var(--ink-3);
  }

  .guardrails__list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Block, not flex. The artboard's right-hand cells are plain blocks that size
     to their content, and only the left column centres its single line — see
     the rule below. Making both flex columns changed how the verdict chip and
     its text stack and added 36px to the card. */
  .guardrails__cell {
    padding: 12px 14px;
    border-radius: 11px;
    background: var(--cell-bg);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
    line-height: 1.5;
  }

  /* Only the left column stretches. The right column's cells carry a verdict
     chip and size themselves, and their total is what sets the card's height —
     stretching both makes the card taller than either needs. */
  .guardrails__col:first-of-type .guardrails__cell {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .guardrails__col:last-of-type .guardrails__cell {
    background: var(--cell-bg-2);
  }

  .guardrails__cell--blocked {
    background: color-mix(in srgb, var(--danger-soft) 6%, transparent);
    border-color: color-mix(in srgb, var(--danger-soft) 32%, transparent);
    color: var(--ink-3);
  }

  .guardrails__cell--allowed {
    background: color-mix(in srgb, var(--live) 10%, transparent);
    border-color: color-mix(in srgb, var(--live) 45%, transparent);
  }

  .guardrails__redacted { color: var(--warn-ink); letter-spacing: 0.1em; }
  .guardrails__verdict { display: block; margin-top: 8px; text-decoration: none; }

  .guardrails__caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    margin-left: 3px;
    background: var(--brand);
    vertical-align: -2px;
    animation: caret 1s step-end infinite;
  }

  /* On paper the spine is a solid ember bar, not a lit panel. */
  .guardrails__spine {
    position: relative;
    width: 66px;
    flex: none;
    border-radius: var(--r-lg);
    background: var(--spine-bg);
    border: 1px solid var(--spine-border);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--spine-shadow);
  }

  .guardrails__spine-text {
    writing-mode: vertical-rl;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    color: var(--spine-ink);
    font-weight: var(--spine-weight);
  }

  .guardrails__spark {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    right: -4px;
  }

  .guardrails__spark--a {
    top: 24%;
    background: var(--live);
    box-shadow: 0 0 0 3.5px color-mix(in srgb, var(--live) 22%, transparent);
    animation: blink 1.4s ease-in-out infinite;
  }

  .guardrails__spark--b {
    top: 62%;
    background: #7c2d05;
    box-shadow: 0 0 0 3.5px rgba(124, 45, 5, 0.2);
    animation: blink 1.9s ease-in-out infinite 0.5s;
  }

  /* 390: the device turns 90°. */
  @media (max-width: 700px) {
    .guardrails__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .guardrails__copy,
    .guardrails__figure {
      grid-column: 1;
      grid-row: auto;
    }

    .guardrails__figure { margin-top: 34px; }

    h2 { margin-top: 16px; font-size: 36px; }

    .guardrails__lede {
      margin-top: 22px;
      max-width: none;
      font-size: 16px;
      line-height: 1.64;
    }

    .guardrails__actions { gap: 8px; margin-top: 22px; max-width: none; }

    .guardrails__card { padding: 20px 18px; border-radius: 20px; }

    .guardrails__cols { flex-direction: column; gap: 0; }

    .guardrails__col { gap: 10px; }

    .guardrails__list { gap: 9px; }

    .guardrails__col:first-of-type .guardrails__cell { flex: none; }

    .guardrails__cell {
      padding: 11px 13px;
      border-radius: 10px;
      font-size: 11.5px;
    }

    .guardrails__label { font-size: 9.5px; }

    .guardrails__spine {
      width: auto;
      height: 44px;
      margin: 16px 0;
      border-radius: 12px;
      box-shadow: var(--spine-shadow);
    }

    .guardrails__spine-text {
      writing-mode: horizontal-tb;
      letter-spacing: 0.3em;
    }

    .guardrails__spark { right: auto; bottom: -4px; top: auto; }
    .guardrails__spark--a { left: 26%; }
    .guardrails__spark--b { left: 64%; }

    .guardrails__caret { width: 6px; height: 13px; background: var(--brand-ink); }
  }
</style>
