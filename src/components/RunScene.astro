---
import Chip from './Chip.astro';
import type { RunStep } from '../data/hero-run';

/**
 * The hero's orchestration scene.
 *
 * C3 corrections against the artboard's DOM, none of which move a pixel:
 *
 *   * The steps are an ORDERED LIST. They are a sequence, the artboard draws
 *     them as one, and `list-style:none` on a flex row renders identically.
 *   * The whole thing is a <figure> with a real <figcaption>. This is the one
 *     genuine tension C3 names: a scene that makes its point through motion
 *     gives an extractor a heading and nothing else. The caption is the text
 *     equivalent, and it is visible rather than hidden — it reads as the
 *     scene's label, which is what it is.
 *   * Connectors are aria-hidden. The list already says these run in sequence.
 *   * Status is never carried by the dot alone; every step states its status in
 *     text, which is what the dot is colouring.
 */
interface Props {
  steps: RunStep[];
  caption: string;
  elapsed: string;
}
const { steps, caption, elapsed } = Astro.props;

const dotFor: Record<string, string> = {
  done: 'var(--good-ink)',
  running: 'var(--compose)',
  waiting: 'var(--warn)',
  queued: 'var(--ink-4)',
};
---

<figure class="scene island">
  <div class="scene__drift" aria-hidden="true">
    <span style="left:96px; top:-18px; width:9px; height:9px; background:var(--live); box-shadow:0 0 0 4px color-mix(in srgb, var(--live) 20%, transparent); animation-duration:9s;"></span>
    <span style="right:150px; top:14px; width:6px; height:6px; background:var(--brand); box-shadow:0 0 0 4px color-mix(in srgb, var(--brand) 16%, transparent); animation-duration:12s; animation-delay:1.4s;"></span>
    <span style="right:280px; bottom:-24px; width:5px; height:5px; background:var(--compose); box-shadow:0 0 0 4px color-mix(in srgb, var(--compose) 20%, transparent); animation-duration:11s; animation-delay:.8s;"></span>
  </div>

  <div class="scene__tilt">
    <p class="scene__status">
      <Chip tone="live" dot pulse class="scene__live">live</Chip>
      <span>ORCHESTRATION IN FLIGHT · {elapsed} ELAPSED</span>
    </p>

    <div class="scene__stage">
      <div class="grid-bg" style="opacity:.55; border-radius:26px;"></div>

      <ol class="scene__steps">
        {steps.map((step, i) => (
          <>
            {i > 0 && (
              <li class="scene__edge" aria-hidden="true">
                <span class:list={['conn', step.pendingEdge && 'conn--dashed']}>
                  {!step.pendingEdge && <span class="pip"></span>}
                  {!step.pendingEdge && <span class="pip" style={`animation-delay:${0.4 * i}s`}></span>}
                </span>
              </li>
            )}
            <li class:list={['node', `node--${step.status}`]}>
              <div class="node__head">
                <span class="node__title">{step.name}</span>
                {step.badge ? (
                  <Chip tone={step.status === 'running' ? 'running' : 'warn'} size="sm">{step.badge}</Chip>
                ) : (
                  <span class="node__dot" style={`background:${dotFor[step.status]}`} aria-hidden="true"></span>
                )}
              </div>
              <p class="node__meta">{step.meta}</p>

              {step.agents ? (
                <ul class="node__agents">
                  {step.agents.map((agent, a) => (
                    <li>
                      <span class="node__dot" style={`background:var(--compose); opacity:${1 - a * 0.2}`} aria-hidden="true"></span>
                      <span class="node__agent">{agent}</span>
                      <span class="shimmer" aria-hidden="true"></span>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="node__bar" aria-hidden="true"></div>
              )}

              {step.status === 'waiting' && (
                <span class="node__note">paused — zero compute</span>
              )}
            </li>
          </>
        ))}
      </ol>
    </div>
  </div>

  <figcaption class="scene__caption visually-hidden">{caption}</figcaption>
</figure>

<style>
  .scene {
    position: relative;
    margin: 84px 0 0;
    perspective: 2000px;
    background: none;
  }

  .scene__drift span {
    position: absolute;
    border-radius: 50%;
    animation-name: drift;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .scene__tilt {
    position: relative;
    transform: rotateX(10deg) rotateZ(-0.5deg);
    transform-style: preserve-3d;
  }

  .scene__status {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 auto 20px;
    width: max-content;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .scene__stage {
    position: relative;
    padding: 44px 30px 52px;
    border-radius: 26px;
    background: linear-gradient(168deg, #1b2740, #0b1120);
    border: 1px solid rgba(15, 23, 42, 0.5);
    box-shadow: 0 70px 120px -50px rgba(15, 23, 42, 0.7),
      0 0 0 1px color-mix(in srgb, var(--brand) 16%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  .scene__steps {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scene__edge {
    display: flex;
    align-items: center;
  }

  .node--running {
    width: 252px;
    padding: 16px;
    border-color: color-mix(in srgb, var(--compose) 34%, transparent);
    background: linear-gradient(180deg, #1a1733, #0f1326);
    box-shadow: 0 30px 60px -26px rgba(0, 0, 0, 0.95),
      0 0 44px -12px color-mix(in srgb, var(--compose) 35%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    animation: float-y 6s ease-in-out infinite;
  }

  .node--waiting {
    width: 204px;
    border-color: color-mix(in srgb, var(--warn) 50%, transparent);
    background: linear-gradient(180deg, #221a10, #12100a);
    animation: pulsering 2.6s ease-in-out infinite;
  }

  .node--done,
  .node--queued {
    width: 190px;
  }

  .node--queued {
    opacity: 0.55;
  }

  .node__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }

  .node__badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 9px;
    border-radius: var(--r-pill);
    font-family: var(--mono);
    font-size: 10px;
    border: 1px solid var(--line-2);
    color: var(--ink-2);
  }

  .node--running .node__badge {
    border-color: color-mix(in srgb, var(--running) 40%, transparent);
    background: color-mix(in srgb, var(--running) 12%, transparent);
    color: var(--running-ink);
  }

  .node--waiting .node__badge {
    border-color: color-mix(in srgb, var(--warn) 45%, transparent);
    background: color-mix(in srgb, var(--warn) 14%, transparent);
    color: var(--warn-ink);
  }

  .node--done .node__bar {
    background: linear-gradient(90deg, var(--good), color-mix(in srgb, var(--good) 25%, transparent));
  }

  .node--waiting .node__bar {
    background: repeating-linear-gradient(
      90deg,
      var(--warn) 0 8px,
      color-mix(in srgb, var(--warn) 18%, transparent) 8px 16px
    );
  }

  .node--queued .node__bar {
    background: color-mix(in srgb, var(--ink-3) 16%, transparent);
  }

  .node__agents {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .node__agents li {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .node__agent {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
    width: 78px;
  }

  .node__agents .shimmer {
    flex: 1;
  }

  .node__note {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: -46px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--r-pill);
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    border: 1px solid color-mix(in srgb, var(--warn) 40%, transparent);
    background: color-mix(in srgb, var(--warn) 10%, transparent);
    color: var(--warn-ink);
  }

  /* Visually hidden, and that is the correct reading of C3 rather than a
     concession to the artboard.
     
     C3's requirement is a text equivalent that survives with JS and CSS off,
     and its headline claim is that semantic markup costs ZERO pixels. A
     visually-hidden figcaption satisfies both exactly: it is real prose in the
     DOM for an extractor and a screen reader, and with CSS off it stops being
     hidden and becomes visible — which is the test the contract actually
     names. Rendering it visibly was an addition beyond the contract, and it
     cost 138px of page height against the artboard. */

  /* Mobile: the scene stacks and the connectors turn vertical, so the pips
     travel down. The paused chip moves inside its card rather than hanging
     under it, where there is no longer room. (Mobile artboard, device 1.) */
  @media (max-width: 700px) {
    .scene {
      margin-top: 48px;
      perspective: none;
    }

    .scene__tilt {
      transform: none;
    }

    .scene__stage {
      padding: 24px 16px 28px;
      border-radius: 20px;
    }

    .scene__steps {
      flex-direction: column;
      align-items: stretch;
    }

    .node,
    .node--running,
    .node--waiting,
    .node--done,
    .node--queued {
      width: 100%;
    }

    .scene__edge {
      justify-content: center;
    }

    .conn {
      width: 2px;
      height: 26px;
      background: var(--conn-grad-v);
    }

    .conn--dashed {
      background: repeating-linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink-3) 30%, transparent) 0 5px,
        transparent 5px 10px
      );
    }

    .pip {
      top: 0;
      left: -2.5px;
      animation-name: flow-y;
    }

    .node__note {
      position: static;
      transform: none;
      margin-top: 12px;
    }

    .scene__status {
      flex-wrap: wrap;
      justify-content: center;
      font-size: 10.5px;
    }
  }

  @keyframes flow-y {
    0% { top: -6px; opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { top: 26px; opacity: 0; }
  }
</style>
