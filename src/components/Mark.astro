---
/**
 * The Tamtree mark and wordmark.
 *
 * The mark is the tiered tree shared with the app (brand decision D4,
 * 2026-10-14): a trunk, two 45° tiers and a ground bar, one round-capped
 * stroke on a 100-unit grid. The viewBox is the tree's own square, so `size`
 * is the tree's height. Below 24px the favicon's one-tier drawing takes over.
 *
 * The SVG is `aria-hidden` rather than titled: the wordmark beside it says
 * "tamtree" in real text, so a title on the glyph would make a screen reader
 * announce the name twice. Decorative here means decorative — the meaning is
 * carried by the text, which is C3's rule for exactly this case.
 *
 * Sizes are written as `var(--mark-glyph/--mark-word, <size>)`, so a container
 * can step the mark down at a breakpoint (the mobile nav does) without a second
 * render. The glyph never shrinks in a crowded flex row: on a 390px phone the
 * nav squeezed it to 0px wide while the wordmark survived.
 */
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}
const { size = 26, wordmark = true, class: className } = Astro.props;
const wordSize = Math.round(size * 0.85);
---

<span class:list={['mark', className]}>
  <svg
    width={size}
    height={size}
    viewBox="21.5 21.5 57 57"
    fill="none"
    stroke="var(--brand)"
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    style={`width:var(--mark-glyph, ${size}px);height:var(--mark-glyph, ${size}px)`}
  >
    <path d="M50 25V75"></path>
    <path d="M39 30 50 41 61 30"></path>
    <path d="M35 42 50 57 65 42"></path>
    <path d="M34 75H66"></path>
  </svg>
  {wordmark && <span class="mark__word" style={`font-size:var(--mark-word, ${wordSize}px)`}>tamtree</span>}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .mark svg {
    flex-shrink: 0;
  }

  .mark__word {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
</style>
