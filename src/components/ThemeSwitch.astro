---
/**
 * The header's theme control: one icon button, where the footer has the
 * labelled Light/Dark pair (ThemeToggle). The header has room for an icon and
 * not for two words, and the footer pair stays the legible statement of the
 * current state.
 *
 * The icon shows what a press will DO — a moon in light, a sun in dark — and
 * the accessible name says it in words. Which icon is visible is decided in
 * CSS from `data-theme` and the system preference, so the right one paints
 * before any script runs; script only keeps the name current.
 *
 * Same storage key and attribute as ThemeToggle and theme-init.js, so the two
 * controls are one setting. Each repaints from a watch on `data-theme`, which
 * keeps them in step whichever one was pressed.
 */
---

<button type="button" class="tswitch" data-theme-switch aria-label="Switch to dark theme">
  <svg class="tswitch__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
  </svg>
  <svg class="tswitch__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path>
  </svg>
</button>

<script>
  const KEY = 'tt-theme';
  const root = document.documentElement;
  const dark = matchMedia('(prefers-color-scheme: dark)');

  function current() {
    const explicit = root.getAttribute('data-theme');
    if (explicit === 'dark' || explicit === 'light') return explicit;
    return dark.matches ? 'dark' : 'light';
  }

  function paint() {
    const next = current() === 'dark' ? 'light' : 'dark';
    for (const el of document.querySelectorAll<HTMLElement>('[data-theme-switch]')) {
      el.setAttribute('aria-label', `Switch to ${next} theme`);
    }
  }

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement)?.closest('[data-theme-switch]')) return;
    const next = current() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* not remembered, still applied */
    }
  });

  new MutationObserver(paint).observe(root, { attributeFilter: ['data-theme'] });
  dark.addEventListener('change', paint);
  paint();
</script>

<style>
  .tswitch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    background: var(--chip-bg);
    color: var(--ink-2);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease);
  }

  .tswitch:hover {
    color: var(--brand-ink);
  }

  /* Light by default: offer the moon. */
  .tswitch__sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .tswitch__moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .tswitch__sun {
    display: block;
  }

  /* No stored choice: follow the system, with the same guard tokens.css uses. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .tswitch__moon {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .tswitch__sun {
      display: block;
    }
  }
</style>
