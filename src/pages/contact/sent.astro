---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import Button from '../../components/Button.astro';

/**
 * Where a no-JS contact POST lands when it went through. The form's script
 * normally shows its own success panel, and a no-JS POST carries no stamp, so
 * this is the rare path — but the server's 303 must point at a real page.
 */
---

<Base title="Message sent" description="Your message to Tamtree was sent." noindex>
  <section class="sec cf-done">
    <div class="wrap cf-done__inner">
      <div aria-hidden="true"><Mark size={40} /></div>
      <p class="cf-done__code">CONTACT · SENT</p>
      <h1>Message sent.</h1>
      <p class="cf-done__lede">We'll reply to the email address you gave, within 30 days at the latest.</p>
      <Button href="/">Back to Tamtree</Button>
    </div>
  </section>
</Base>

<style>
  .cf-done { padding: 120px 0 140px; text-align: center; }
  .cf-done__inner { display: flex; flex-direction: column; align-items: center; }
  .cf-done__code { margin-top: 28px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.24em; color: var(--good-ink); }
  h1 { margin-top: 18px; font-size: 64px; font-weight: 800; }
  .cf-done__lede { margin: 24px 0 40px; max-width: 520px; font-size: 18px; line-height: 1.62; color: var(--ink-2); }
  @media (max-width: 700px) { h1 { font-size: 40px; } }
</style>
