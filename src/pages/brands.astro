---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Chip from '../components/Chip.astro';
import Button from '../components/Button.astro';
import { breadcrumbs, ORG_ID, SITE } from '../lib/seo';
import { formatLegalDate, legal } from '../data/legal';
import { founding, options, platforms } from '../data/brands';

/**
 * /brands/ — the done-for-you social video service, run on Tamtree. A sales
 * page for business owners rather than builders, so it argues in outcomes,
 * prices and controls, not runtime features.
 *
 * Every number on it comes from src/data/brands.ts. The founding count is a
 * public promise: it is printed from `founding.placesLeft` and nothing else.
 *
 * Applications go through the contact pipeline (`/api/contact`, topic
 * `brands`), so there is no second inbox. The structured fields are folded
 * into the one `message` the server accepts, just before the stamped send.
 *
 * C3: the steps are an <ol>, the options are an <ol> of articles (their order
 * is the ladder), the comparison is a <table>, the FAQ is <details>.
 */
const closes = formatLegalDate(founding.closes);
const live = platforms.live.join(', ').replace(/, ([^,]*)$/, ' and $1');
const soon = platforms.soon.join(' and ');
const open = founding.placesLeft > 0;
const reservedNote = founding.reserved > 0 ? ` · ${founding.reserved} reserved` : '';

const steps = [
  {
    title: 'Send us what you have.',
    body: 'Drop long videos or raw footage in a shared folder, or point us at your YouTube channel. New uploads are picked up automatically.',
  },
  {
    title: 'We turn it into shorts.',
    body: 'Best moments picked against your brand brief, reframed vertical, captioned, framed in your fonts and colours. A person reviews every batch.',
  },
  {
    title: 'You approve, in one place.',
    body: 'Each week a batch lands in your approval queue. Approve, or send one back with a note. Nothing is ever posted without your yes.',
  },
  {
    title: 'We publish and report.',
    body: `Approved shorts go out to ${live} on schedule. Once a month you get what was posted, what was watched and what we will change.`,
  },
];

const controls = [
  {
    title: 'Nothing posts without you.',
    body: 'Approval is a step in the workflow itself, not a promise in an email. A short that has not been approved cannot be published.',
  },
  {
    title: 'Your accounts stay yours.',
    body: 'You connect each account through the platform’s own sign-in. We never ask for a password, and you can disconnect us from your platform settings at any time.',
  },
  {
    title: 'AI is labelled, never hidden.',
    body: 'Where a short uses AI-generated footage or voice, we switch on the platform’s own AI label. No fake reviews, no invented customers, ever.',
  },
  {
    title: 'Every step on the record.',
    body: 'Each short carries its source, who approved it and when, and where it went live. If you ever ask “who posted that?”, there is an answer.',
  },
  {
    title: 'Licensed music only.',
    body: 'Tracks come from commercial libraries cleared for business accounts, so your posts are not muted or struck.',
  },
  {
    title: 'An Australian business.',
    body: `Tamtree is run by ${legal.entity} (ABN ${legal.abn}), under ${legal.governingState} law. You deal with the people who build it.`,
  },
];

const compare = {
  cols: ['Tamtree Publish', 'Do-it-yourself tools', 'A typical agency', 'Hire a content person'],
  rows: [
    { label: 'Monthly cost', cells: ['A$199 founding, A$790 standard', 'US$40–55 in tools, plus your hours', 'About A$960 median entry price*', 'A$65–80k a year, plus super'] },
    { label: 'Who does the work', cells: ['We do', 'You do', 'They do', 'They do, while they stay'] },
    { label: 'Shorts a month', cells: ['Up to 20', 'However many you have time for', 'Usually fewer, by package', 'Depends on the person'] },
    { label: 'Posts without your approval', cells: ['Never — it can’t', 'Not applicable', 'Check the contract', 'Up to them'] },
    { label: 'Who owns the accounts', cells: ['You, always', 'You', 'Check the contract', 'You'] },
    { label: 'Commitment', cells: ['3 months, then monthly', 'Monthly', 'Varies', 'Employment'] },
  ],
};

const faqs = [
  {
    q: 'Which platforms do you publish to?',
    a: `${live} today — Tamtree publishes to them every day. ${soon} are in development and join every option at no extra cost when they go live.`,
  },
  {
    q: 'What if I don’t like a short?',
    a: 'Send it back from the approval queue with a note. It is re-cut or dropped, and it never goes out. Over the first few weeks the brief learns what you approve.',
  },
  {
    q: 'Is it made by AI?',
    a: 'Partly, and we say so. AI finds the moments, cuts, captions and drafts. A person reviews every batch before it reaches you, and you approve every short before it is posted.',
  },
  {
    q: 'Who owns the content and the accounts?',
    a: 'You do: your footage, every short we make from it, and every account it is posted to. If you leave, there is nothing to hand back.',
  },
  {
    q: 'How long is the commitment?',
    a: 'Three months, then month to month. The founding price covers those first three months.',
  },
  {
    q: 'What happens after the founding months?',
    a: `You keep ${founding.afterDiscount}% off the standard price for the next ${founding.afterMonths} months — A$590 a month for Publish, A$1,650 for Produce.`,
  },
  {
    q: 'What do you ask of founding clients?',
    a: 'Three months, a short testimonial if you are happy, permission to publish a case study with your numbers, and a 15-minute feedback call each month. That is the trade for the price.',
  },
  {
    q: 'Do the prices include GST?',
    a: 'Prices are in Australian dollars and exclude GST.',
  },
  {
    q: 'I’m in health, supplements or finance. Can you help?',
    a: 'Tell us when you apply. Those industries have advertising rules of their own, on claims and testimonials among others. We will tell you on the first call whether we can take you on, and how the review works if we can.',
  },
];

const jsonLd = [
  breadcrumbs([{ label: 'For brands' }], Astro.url.pathname),
  {
    '@type': 'Service',
    '@id': `${SITE}/brands/#service`,
    name: 'Tamtree for brands — short-form video, made and published for you',
    serviceType: 'Social media video production and publishing',
    provider: { '@id': ORG_ID },
    areaServed: { '@type': 'Country', name: 'Australia' },
    offers: options.map((o) => ({
      '@type': 'Offer',
      name: o.name,
      description: o.tagline,
      priceCurrency: 'AUD',
      price: o.standard.replace(/[^0-9.]/g, ''),
    })),
  },
];
---

<Base
  title="For brands"
  description={`You have the brand. We make the shorts and publish them to ${live} — you approve every one. Founding places from A$199 a month.`}
  jsonLd={jsonLd}
>
  <!-- ── hero ─────────────────────────────────────────────────────────── -->
  <section class="sec bh" aria-labelledby="bh-title">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="bh__wash" aria-hidden="true"></div>

    <div class="wrap bh__grid">
      <div class="bh__copy">
        <nav class="bh__crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-current="page">For brands</span></li>
          </ol>
        </nav>

        <Eyebrow>Tamtree for brands</Eyebrow>
        <h1 id="bh-title">
          You have the brand.<br /><span class="bh__accent">We fill the feeds.</span>
        </h1>
        <p class="bh__lede">
          Your long videos and raw footage become on-brand shorts on {live} — every week, without
          hiring. You approve every one before it goes out.
        </p>

        <div class="bh__offer">
          <p class="bh__price">
            <span class="bh__price-n">A$199</span>
            <span class="bh__price-u">a month</span>
          </p>
          <p class="bh__price-note">
            Up to 20 shorts a month. <s>A$790</s> for our {founding.places} founding clients.
          </p>
        </div>

        <div class="bh__ctas">
          <Button href="#apply">{open ? 'Claim a founding place' : 'Join the waitlist'}</Button>
          <Button href="#options" variant="ghost">See the three options</Button>
        </div>

        <ul class="bh__facts" aria-label="At a glance">
          <li><Chip tone="live" dot size="sm">{founding.placesLeft} of {founding.places} places open{reservedNote}</Chip></li>
          <li><Chip size="sm">closes {closes}</Chip></li>
          <li><Chip size="sm">AUD · ex-GST</Chip></li>
        </ul>
      </div>

      <figure class="run" aria-labelledby="run-cap">
        <figcaption id="run-cap" class="run__head">
          <span class="run__title">Weekly shorts</span>
          <span class="run__eg">Example run</span>
        </figcaption>

        <ol class="run__steps">
          <li class="run__step run__step--done">
            <span class="run__pip" aria-hidden="true"></span>
            <div>
              <p class="run__k">Source</p>
              <p class="run__v">Webinar — “Spring launch”, 48 min</p>
            </div>
            <Chip tone="good" size="sm">done</Chip>
          </li>
          <li class="run__step run__step--done">
            <span class="run__pip" aria-hidden="true"></span>
            <div>
              <p class="run__k">Cut</p>
              <p class="run__v">20 shorts · captions · brand frame</p>
            </div>
            <Chip tone="good" size="sm">done</Chip>
          </li>
          <li class="run__step run__step--done">
            <span class="run__pip" aria-hidden="true"></span>
            <div>
              <p class="run__k">Your approval</p>
              <p class="run__v">18 approved · 2 sent back with notes</p>
            </div>
            <Chip tone="good" size="sm">approved</Chip>
          </li>
          <li class="run__step run__step--live">
            <span class="run__pip" aria-hidden="true"></span>
            <div>
              <p class="run__k">Publish</p>
              <ul class="run__plats" aria-label="Published to">
                {platforms.live.map((p) => <li>{p} <b>6</b></li>)}
              </ul>
            </div>
            <Chip tone="live" dot pulse size="sm">live</Chip>
          </li>
        </ol>

        <div class="run__foot">
          <span>0 posts without approval</span>
          <span>{soon}: soon</span>
        </div>
      </figure>
    </div>
  </section>

  <!-- ── proof strip ──────────────────────────────────────────────────── -->
  <section class="strip" aria-label="What you can count on">
    <div class="wrap">
      <ul class="strip__list">
        <li><b>{live}</b><span>publishing live, every day</span></li>
        <li><b>You approve</b><span>every short, before it posts</span></li>
        <li><b>You own</b><span>every account and every file</span></li>
        <li><b>3 months</b><span>then month to month</span></li>
      </ul>
    </div>
  </section>

  <!-- ── the problem ──────────────────────────────────────────────────── -->
  <section class="sec bs" aria-labelledby="bs-problem">
    <div class="seam" aria-hidden="true"></div>
    <div class="wrap bs__problem">
      <div>
        <Eyebrow>The gap</Eyebrow>
        <h2 id="bs-problem">The strategy is done.<br />The posting isn’t.</h2>
      </div>
      <div class="bs__problem-body">
        <p>
          You know your audience, your voice and what you want to say. You have hours of video
          that said it well once. What you don’t have is someone cutting it into twenty shorts a
          month, fitting it to each platform and posting it on time — every week, without fail.
        </p>
        <p>
          That is the part we take over. Your brand stays yours. Your strategy stays yours. The
          production line becomes ours.
        </p>
      </div>
    </div>
  </section>

  <!-- ── how it works ─────────────────────────────────────────────────── -->
  <section class="sec bs" aria-labelledby="bs-how">
    <div class="seam" aria-hidden="true"></div>
    <div class="wrap">
      <Eyebrow>How it works</Eyebrow>
      <h2 id="bs-how">Four steps. One of them is yours.</h2>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class:list={['steps__item', i === 2 && 'steps__item--you']}>
            <p class="steps__n">
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {i === 2 && <Chip tone="brand" size="sm">you</Chip>}
            </p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── options ──────────────────────────────────────────────────────── -->
  <section class="sec bs" id="options" aria-labelledby="bs-options">
    <div class="seam" aria-hidden="true"></div>
    <div class="wrap">
      <div class="opts__head">
        <div>
          <Eyebrow>Three options</Eyebrow>
          <h2 id="bs-options">Pick by what you already have.</h2>
        </div>
        <p>
          One price each, no add-ons to decode. Founding prices hold for your first {`${founding.months} months`}; every option publishes to {live} today, with {soon} added when ready.
        </p>
      </div>

      <ol class="opts">
        {options.map((o) => (
          <li class:list={['opt', o.featured && 'opt--featured']}>
            <article aria-labelledby={`opt-${o.id}`}>
              <header class="opt__top">
                <p class="opt__n">{o.n}</p>
                {o.featured && <Chip tone="brand" size="sm">most popular start</Chip>}
              </header>
              <h3 id={`opt-${o.id}`}>{o.name}</h3>
              <p class="opt__tag">{o.tagline}</p>

              <div class="opt__price">
                <p class="opt__founding">
                  <span class="opt__amt">{o.founding}</span>
                  <span class="opt__unit">{o.foundingUnit}</span>
                </p>
                <p class="opt__note">{o.foundingNote}</p>
                <p class="opt__std">
                  Standard <s>{o.standard}</s> {o.standardNote}
                </p>
              </div>

              <p class="opt__for"><b>For you if</b> {o.forYou.charAt(0).toLowerCase() + o.forYou.slice(1)}</p>

              <ul class="opt__list" aria-label={`${o.name} includes`}>
                {o.includes.map((it) => <li>{it}</li>)}
              </ul>

              <a class:list={['btn', o.featured ? 'btn--primary' : 'btn--ghost', 'opt__cta']} href={`#apply`} data-option={o.id}>
                Start with {o.name}
              </a>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── founding offer ───────────────────────────────────────────────── -->
  <section class="sec island fo" aria-labelledby="fo-title">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="ember-wash fo__wash" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <div class="wrap fo__grid">
      <div class="fo__count">
        <p class="fo__big" aria-hidden="true">{founding.placesLeft}<span>of {founding.places}</span></p>
        <p class="fo__label">
          {open ? `${founding.placesLeft} of ${founding.places} founding places open${reservedNote}` : 'Founding places are full'}
        </p>
        <p class="fo__close">Closes {closes}, or when the places are gone.</p>
      </div>

      <div class="fo__copy">
        <Eyebrow>The founding offer</Eyebrow>
        <h2 id="fo-title">Up to 75% off. For five businesses, once.</h2>
        <p class="fo__lede">
          We are opening with five clients, not five hundred, so every one gets our full attention
          and becomes a story we can tell. That is why the price is this low — and why it is capped.
        </p>
        <ul class="fo__terms">
          <li><b>{founding.months} months at the founding price.</b> A$199 for Publish, A$790 for Produce. Setup included.</li>
          <li><b>Then {founding.afterDiscount}% off for {founding.afterMonths} months.</b> A$590 for Publish, A$1,650 for Produce. No cliff at month four.</li>
          <li><b>In return:</b> a short testimonial if you are happy, a case study with your numbers, and a 15-minute call each month to tell us what to fix.</li>
        </ul>
        <div class="fo__cta">
          <Button href="#apply">{open ? 'Claim a founding place' : 'Join the waitlist'}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── controls ─────────────────────────────────────────────────────── -->
  <section class="sec bs" aria-labelledby="bs-control">
    <div class="seam" aria-hidden="true"></div>
    <div class="wrap">
      <Eyebrow>What you control</Eyebrow>
      <h2 id="bs-control">Your brand. Your accounts. Your call.</h2>
      <ul class="ctrl">
        {controls.map((c) => (
          <li class="ctrl__item">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── comparison ───────────────────────────────────────────────────── -->
  <section class="sec bs" aria-labelledby="bs-compare">
    <div class="seam" aria-hidden="true"></div>
    <div class="wrap">
      <Eyebrow>Against the alternatives</Eyebrow>
      <h2 id="bs-compare">What A$199 is up against.</h2>
      <div class="cmp__wrap">
        <table class="cmp">
          <caption class="visually-hidden">Tamtree Publish compared with doing it yourself, an agency, and hiring</caption>
          <thead>
            <tr>
              <td></td>
              {compare.cols.map((c, i) => <th scope="col" class:list={[i === 0 && 'cmp__us']}>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {compare.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {r.cells.map((c, i) => <td class:list={[i === 0 && 'cmp__us']} data-col={compare.cols[i]}>{c}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cmp__src">
        * Median published entry-level price for organic social media management across 140 Australian
        agencies, Digital Nomads HQ, June 2026. Tool prices are typical 2026 list prices for a clipping
        tool plus a publishing tool.
      </p>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="sec bs" aria-labelledby="bs-faq">
    <div class="seam" aria-hidden="true"></div>
    <div class="wrap faq">
      <div>
        <Eyebrow>Questions</Eyebrow>
        <h2 id="bs-faq">Asked before you sign.</h2>
        <p class="faq__aside">Something not here? Ask it in the form below — it goes to the people who will do the work.</p>
      </div>
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── apply ────────────────────────────────────────────────────────── -->
  <section class="sec bs" id="apply" aria-labelledby="ap-title">
    <div class="seam" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ap">
        <div class="ap__side">
          <Eyebrow>{open ? 'Apply' : 'Waitlist'}</Eyebrow>
          <h2 id="ap-title">{open ? 'Claim a founding place.' : 'Be next in line.'}</h2>
          <p class="ap__lede">
            Tell us what you have. A person reads every application and replies, usually within two
            business days.
          </p>
          <ol class="ap__next" aria-label="What happens next">
            <li><b>A 20-minute call.</b> We check the fit and look at your brand and footage together.</li>
            <li><b>Connect and brief.</b> You connect your accounts on the call; we write the brand brief.</li>
            <li><b>Your first batch.</b> Shorts land in your approval queue within 14 days.</li>
          </ol>
          <p class="ap__fine">No payment now. Nothing is billed until you have approved your first batch.</p>
        </div>

        <div class="ap__sheet">
          <form class="cf" id="brands-apply" action="/api/contact" method="post">
            <input type="hidden" name="topic" value="brands" />
            <textarea name="message" hidden aria-hidden="true" tabindex="-1"></textarea>

            <div class="cf__pair">
              <div class="cf__field">
                <label for="ap-name">Your name</label>
                <input id="ap-name" name="name" type="text" autocomplete="name" maxlength="200" required />
              </div>
              <div class="cf__field">
                <label for="ap-email">Work email</label>
                <input id="ap-email" name="email" type="email" autocomplete="email" required />
              </div>
            </div>

            <div class="cf__field">
              <label for="ap-biz">Business and website</label>
              <input id="ap-biz" name="biz" type="text" maxlength="300" placeholder="e.g. Harbour Physio — harbourphysio.com.au" required />
            </div>

            <fieldset class="cf__field cf__options">
              <legend>Which option fits?</legend>
              <div class="cf__radios">
                {options.map((o, i) => (
                  <label class="cf__radio">
                    <input type="radio" name="option" value={o.name} checked={i === 0} data-option={o.id} />
                    <span><b>{o.name}</b> {o.founding}{o.foundingUnit === '/mo' ? '/mo' : ''}</span>
                  </label>
                ))}
                <label class="cf__radio">
                  <input type="radio" name="option" value="Not sure yet" />
                  <span><b>Not sure yet</b></span>
                </label>
              </div>
            </fieldset>

            <div class="cf__field">
              <label for="ap-have">What do you have today? <span class="cf__opt">(optional)</span></label>
              <textarea id="ap-have" name="have" rows="4" maxlength="3000" placeholder="e.g. a fortnightly podcast on YouTube, brand guidelines, no one posting since March"></textarea>
            </div>

            {/* Honeypot — off-screen and out of the tab order, so only a bot fills it. */}
            <label class="cf__trap" aria-hidden="true">
              Company <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>

            <div class="cf__actions">
              <button class="btn btn--primary cf__submit" type="submit">
                <span class="cf__spin" aria-hidden="true"></span>
                <span class="cf__label">{open ? 'Apply for a founding place' : 'Join the waitlist'}</span>
              </button>
              <p class="cf__note">
                How we handle what you send: <a href="/privacy/#what-we-collect">privacy policy</a>.
              </p>
            </div>
          </form>

          <noscript>
            <p class="cf__noscript">The form needs JavaScript turned on, to keep bots out.</p>
          </noscript>

          <p class="cf__msg" id="ap-msg" role="status" aria-live="polite" hidden></p>

          <div class="cf__done" id="ap-done" role="status" tabindex="-1" hidden>
            <p class="cf__done-title">Application received.</p>
            <p class="cf__done-text">We’ll reply to <strong class="cf__done-email"></strong> to book your call.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { sendStamped } from '../lib/stamp';

  const FAILED: Record<string, string> = {
    email: "That doesn't look like an email address — check it and try again.",
    message: 'Your application is too long. Shorten “What do you have today?” and send it again.',
    busy: 'Too many messages right now. Give it a few minutes and try again.',
  };
  const FALLBACK = "Something went wrong on our side and your application wasn't sent. Please try again shortly.";

  const form = document.querySelector<HTMLFormElement>('#brands-apply');
  const msg = document.getElementById('ap-msg');
  const done = document.getElementById('ap-done');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const label = submit?.querySelector<HTMLElement>('.cf__label');
  const cta = label?.textContent ?? '';

  // "Start with Produce" preselects Produce in the form below.
  document.querySelectorAll<HTMLAnchorElement>('a[data-option]').forEach((a) => {
    a.addEventListener('click', () => {
      const radio = form?.querySelector<HTMLInputElement>(`input[data-option="${a.dataset.option}"]`);
      if (radio) radio.checked = true;
    });
  });

  const busy = (on: boolean) => {
    if (!submit) return;
    submit.disabled = on;
    submit.setAttribute('aria-busy', String(on));
    submit.classList.toggle('cf__submit--busy', on);
    if (label) label.textContent = on ? 'Sending…' : cta;
  };

  window.addEventListener('pageshow', () => busy(false));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!msg || !done || submit?.disabled) return;

    // The server takes one free-text message; the structured fields ride in it.
    const data = new FormData(form);
    const field = (k: string) => String(data.get(k) ?? '').trim();
    const body = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    if (body) {
      body.value = [
        `Business: ${field('biz')}`,
        `Option: ${field('option') || 'Not sure yet'}`,
        '',
        field('have') || '(nothing added)',
        '',
        '— Applied from tamtree.io/brands/',
      ].join('\n');
    }

    busy(true);
    msg.hidden = true;
    const result = await sendStamped(form);
    busy(false);
    if (result.ok) {
      const slot = done.querySelector('.cf__done-email');
      if (slot) slot.textContent = field('email');
      form.hidden = true;
      done.hidden = false;
      done.focus();
      return;
    }
    msg.textContent = FAILED[result.error] ?? FALLBACK;
    msg.hidden = false;
  });
</script>

