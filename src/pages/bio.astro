---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { breadcrumbs, ORG_ID, SITE, WEBSITE_ID } from '../lib/seo';
import { founding } from '../data/brands';
import { profiles } from '../data/social';

/**
 * /bio/ — the link-in-bio page. Instagram allows one link on a profile, so
 * this is the page that link points at: the few places a visitor from a reel
 * actually wants to go, then every Tamtree profile.
 *
 * Built for a phone held in one hand: one column, full-width tap targets of at
 * least 56px, the most useful link first. The profiles come from
 * src/data/social.ts and the founding count from src/data/brands.ts, so
 * nothing on this page is typed twice.
 *
 * The links are an <ul> of plain <a>s — a list of destinations, not actions.
 * Platform glyphs are `aria-hidden`; the visible name is the accessible name.
 */
const live = profiles.filter((p) => p.url);
const open = founding.placesLeft > 0;

const links = [
  {
    href: '/brands/',
    title: 'Done-for-you shorts for your brand',
    note: open
      ? `Founding offer · ${founding.placesLeft} of ${founding.places} places left`
      : 'Branded shorts, approved by you',
    featured: true,
  },
  { href: '/contact/?topic=brands', title: 'Book a chat', note: 'Tell us about your brand' },
  { href: '/how-it-works/', title: 'How Tamtree works', note: 'Workflows with a person in the loop' },
  { href: '/blog/', title: 'Read the blog', note: 'Notes from building it' },
  { href: '/', title: 'tamtree.io', note: 'The website' },
];

// Simple stroked glyphs on a 24-unit grid, drawn in currentColor.
const glyphs: Record<string, string> = {
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>',
  facebook: '<path d="M14.5 21v-8h2.7l.4-3.2h-3.1V7.9c0-.9.3-1.6 1.6-1.6h1.7V3.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H8.5V13h2.7v8"/>',
  youtube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor"/>',
  tiktok: '<path d="M13.5 3.5v11.2a3.3 3.3 0 1 1-3.3-3.3"/><path d="M13.5 3.5c.4 2.6 2.2 4.3 4.8 4.5"/>',
  linkedin:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5v6M8 7.6v.1M11.5 16.5v-6M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6v3.5"/>',
};

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${SITE}/bio/#page`,
    url: `${SITE}/bio/`,
    name: 'Tamtree links',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
  },
  breadcrumbs([{ label: 'Links' }], Astro.url.pathname),
];
---

<Base
  title="Links"
  description="Every Tamtree link in one place: done-for-you shorts for brands, booking a chat, the blog, and Tamtree on Instagram, Facebook and more."
  jsonLd={jsonLd}
>
  <section class="links wrap">
    <header class="links-head">
      <Mark size={56} wordmark={false} />
      <h1>tamtree</h1>
      <p>Your content, handled. Branded shorts made for you, and nothing posts without your yes.</p>
    </header>

    <ul class="links-list" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class:list={['link', l.featured && 'link--featured']}>
              <span class="link-text">
                <span class="link-title">{l.title}</span>
                <span class="link-note">{l.note}</span>
              </span>
              <span class="link-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      live.length > 0 && (
        <>
          <h2 class="links-sub">
            <Eyebrow>Follow Tamtree</Eyebrow>
          </h2>
          <ul class="links-list" role="list">
            {live.map((p) => (
              <li>
                <a href={p.url} class="link link--social" rel="me noopener">
                  <svg
                    class="link-glyph"
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                    set:html={glyphs[p.id]}
                  />
                  <span class="link-text">
                    <span class="link-title">{p.name}</span>
                    {p.handle && <span class="link-note">{p.handle}</span>}
                  </span>
                  <span class="link-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <style>
    .links {
      max-width: 520px;
      padding-top: clamp(40px, 8vw, 72px);
      padding-bottom: clamp(56px, 10vw, 96px);
    }

    .links-head {
      display: grid;
      justify-items: center;
      gap: 12px;
      text-align: center;
      margin-bottom: 32px;
    }

    .links-head h1 {
      margin: 0;
      font-family: var(--display);
      font-weight: 800;
      font-size: clamp(36px, 9vw, 48px);
      line-height: 1;
      letter-spacing: -0.02em;
      background: var(--brand-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .links-head p {
      margin: 0;
      max-width: 36ch;
      color: var(--ink-2);
      font-size: 16px;
      line-height: 1.5;
    }

    .links-sub {
      margin: 36px 0 14px;
      text-align: center;
      font-size: inherit;
    }

    .links-list {
      display: grid;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .link {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 64px;
      padding: 12px 20px;
      border-radius: 18px;
      background: var(--surface-2);
      border: 1px solid var(--line-2);
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
      color: var(--ink);
      text-decoration: none;
      transition: transform var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease),
        box-shadow var(--dur-1) var(--ease);
    }

    .link:hover {
      transform: translateY(-2px);
      border-color: var(--brand);
      box-shadow: 0 12px 26px -14px rgba(234, 88, 12, 0.45);
    }

    .link:focus-visible {
      outline: 2px solid var(--brand);
      outline-offset: 3px;
    }

    /* Deeper than --btn-primary-bg on purpose: two lines of white text, the
       note at 14px, need AA in both themes (white on #c2410c is 5.2:1). The
       solid colour underneath is what axe measures, since it cannot read a
       gradient. */
    .link--featured {
      background-color: #9a3609;
      background-image: linear-gradient(180deg, #c2410c, #9a3609);
      border-color: transparent;
      box-shadow: var(--btn-primary-shadow);
      color: #ffffff;
    }

    .link--featured:hover {
      border-color: transparent;
      box-shadow: var(--btn-primary-shadow-hover);
    }

    .link--featured .link-note {
      color: #ffffff;
    }

    .link-text {
      display: grid;
      gap: 2px;
      flex: 1;
      min-width: 0;
    }

    .link-title {
      font-weight: 600;
      font-size: 16px;
      line-height: 1.3;
    }

    .link-note {
      font-size: 14px;
      line-height: 1.35;
      color: var(--ink-3);
    }

    .link-glyph {
      flex: none;
      color: var(--brand-ink);
    }

    .link-arrow {
      flex: none;
      font-size: 18px;
      opacity: 0.7;
    }

    @media (prefers-reduced-motion: reduce) {
      .link,
      .link:hover {
        transition: none;
        transform: none;
      }
    }
  </style>
</Base>
