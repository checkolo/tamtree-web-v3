---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Primitives from '../components/sections/Primitives.astro';
import Durability from '../components/sections/Durability.astro';
import Guardrails from '../components/sections/Guardrails.astro';
import Evals from '../components/sections/Evals.astro';
import Knowledge from '../components/sections/Knowledge.astro';
import Interop from '../components/sections/Interop.astro';
import Trust from '../components/sections/Trust.astro';
import Waitlist from '../components/sections/Waitlist.astro';
import { organization, softwareApplication, website } from '../lib/seo';

const description =
  'An agent-first workflow orchestrator. Deterministic pipelines and autonomous agent crews on one crash-proof engine, with guardrails, evals and budgets built in.';
---

<Base
  title="Tamtree"
  description={description}
  jsonLd={[organization(), website(), softwareApplication(description)]}
>
  <meta
    slot="head"
    name="google-site-verification"
    content="LK4Hrco4h_ZLMBl_y_6Gw7Lf5LlEd_eQ9b3bAXTvsIo"
  />
  <Hero />
  <Primitives />
  <Durability />
  <Guardrails />
  <Evals />
  <Knowledge />
  <Interop />
  <Trust />
  <Waitlist />
</Base>
