---
import Base from '../../layouts/Base.astro';
import '../../brand/prose.css';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { category as lookup, categoryHref } from '../../lib/categories';

export async function getStaticPaths() {
  // Drafts are visible in dev, and in a build made with TT_INCLUDE_DRAFTS=1 —
  // which is how gate:directives gets the pipeline fixture into dist/ without
  // ever publishing it.
  const includeDrafts = import.meta.env.DEV || !!import.meta.env.TT_INCLUDE_DRAFTS;
  const posts = await getCollection('posts', ({ data }) => includeDrafts || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/**
 * The empty-body guard, and why it is on the page rather than in a gate.
 *
 * A throw inside an mdast plugin does not fail anything. The glob loader
 * catches it, caches the entry with EMPTY rendered content, and exits 0 — so a
 * post with an unknown directive ships as a title, a date and nothing else.
 * `gate:directives` already checks for this in `dist`, which covers CI.
 *
 * It does not cover the case that has now cost two sessions: **the dev server**.
 * The Sätteri processor is constructed once, in `astro.config.mjs`, so editing
 * `src/plugins/directives.mjs` does NOT take effect in a running dev server —
 * measured, not assumed. Add a directive to the vocabulary and use it, and the
 * running server renders it with the OLD vocabulary, throws, and caches an
 * empty body. The page then stays blank through every subsequent edit, with no
 * error in the terminal the second time round, until the server is restarted.
 *
 * So the check lives where both cases pass through: in dev it says what
 * happened, in a build it fails outright. This throw is in a page component
 * rather than a plugin, so nothing catches it and the build actually stops.
 */
// Measured, because the first version of this check got it backwards: on a
// swallowed failure `post.rendered` is `undefined` ENTIRELY — not an empty
// string — so testing for a blank string excluded the one case worth catching.
// A healthy entry always has `rendered.html` populated once `render()` has run.
const emptyRender = !post.rendered?.html?.trim() && !!post.body?.trim();

if (emptyRender && import.meta.env.PROD) {
  throw new Error(
    `[blog] "${post.id}" rendered to an empty body from ${post.body?.length ?? 0} characters of ` +
      `Markdown. Something in the pipeline threw and the content loader swallowed it — check ` +
      `the build output for "[glob-loader] Error rendering ${post.id}.md". An unknown or ` +
      `malformed directive is the usual cause.`
  );
}
const published = post.data.publishDate;
const cat = lookup(post.data.category);

/**
 * The hero, twice: once for the page and once for the share card.
 *
 * The card gets JPEG rather than the WebP the page uses. WebP is the right
 * format to send a browser and the wrong one to hand a social crawler — several
 * still refuse it and fall back to no image at all, which is exactly the empty
 * card `twitter:card` was promising before this existed. 1200px is the width
 * every card spec asks for.
 */
const { hero, heroAlt } = post.data;
const share = hero ? await getImage({ src: hero, width: 1200, format: 'jpeg' }) : null;
---

<Base
  title={post.data.title}
  description={post.data.description}
  markdownHref={`/blog/${post.id}.md`}
  image={share?.src}
>
  <article class="post">
    <div class="wrap">
      {/* The reading sheet. The constellation is back behind the blog, and a
          moving dot-network directly under body copy is what made a post hard
          to read — so the words sit on an opaque surface and the network stays
          visible around it, framing the page instead of competing with it. */}
      <div class="post__sheet">
        {/* The category is a route now, so the eyebrow is a way back to it
            rather than a label of the slug. */}
        <p class="eyebrow"><a href={categoryHref(post.data.category)}>{cat.label}</a></p>
        <h1>{post.data.title}</h1>
        <p class="post__meta">
          <time datetime={published.toISOString()}>
            {published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </p>
        {
          hero && (
            <Image
              class="post__hero"
              src={hero}
              alt={heroAlt ?? ''}
              widths={[640, 960, 1280]}
              sizes="(max-width: 860px) 92vw, 1004px"
              loading="eager"
            />
          )
        }

        {
          /* Dev only — a build throws instead, above. */
          emptyRender && (
            <div class="post__void">
              <p><strong>This post rendered to an empty body.</strong></p>
              <p>
                Something in the Markdown pipeline threw and the content loader swallowed it, so
                the page shipped with a heading and nothing under it. Look in the dev server's
                output for <code>[glob-loader] Error rendering {post.id}.md</code>.
              </p>
              <p>
                If the terminal says nothing, the error was cached on an earlier render. The
                Sätteri processor is built once in <code>astro.config.mjs</code>, so edits to{' '}
                <code>src/plugins/directives.mjs</code> do not reach a running dev server —{' '}
                <strong>restart it</strong>, and clear <code>.astro</code> and{' '}
                <code>node_modules/.astro</code>, which are two separate caches.
              </p>
            </div>
          )
        }

        <div class="post__body">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .post {
    padding-block: var(--sec-y);
  }

  /* Opaque, deliberately. The constellation is a backdrop for the blog, not a
     texture under the paragraphs: --page is the token every solid surface is
     measured against, so this is the same ground the site uses everywhere the
     eye has to rest. */
  .post__sheet {
    max-width: 1180px;
    margin-inline: auto;
    padding: 56px 88px 68px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--page);
    box-shadow: var(--card-shadow);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--brand-ink);
  }

  h1 {
    margin-top: 14px;
    font-size: clamp(32px, 4.4vw, 52px);
    max-width: 20ch;
  }

  .post__meta {
    margin-top: 18px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }

  /* The hero sits under the meta rule, not above the title. A picture before
     the headline pushes the one thing the reader came for below the fold, and
     the eyebrow/title/date block is what tells them they are in the right
     place. */
  .post__hero {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 34px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--field-bg);
  }

  /* Loud on purpose, and dev-only — a production build never reaches this page
     because the guard above throws instead. */
  .post__void {
    margin-top: 36px;
    padding: 22px 24px;
    border: 2px solid var(--danger);
    border-radius: 12px;
    background: color-mix(in srgb, var(--danger) 8%, transparent);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .post__void p { margin: 10px 0 0; }
  .post__void p:first-child { margin: 0; color: var(--danger); }
  .post__void code { font-family: var(--mono); font-size: 0.92em; }

  /* Long-form measure. Everything the Markdown pipeline emits lands here, so
     this is where the reading rhythm is set rather than in each directive. */
  .post__body {
    margin-top: 36px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  /* Direct children only.
     These rules used to match at any depth, which meant they also reached the
     <p> inside a callout and the <h3> a card generates — a class selector beats
     prose.css's element selectors, so the components silently lost their own
     spacing and type scale to the page's. The child combinator keeps this
     owning the rhythm of the post's own blocks and nothing nested inside a
     directive, which owns its own. */
  /* Plain running text gets its own measure, narrower than the sheet: a wide
     sheet is what the hero and the directive blocks (cards, tables, code)
     need room for, but a 100+ character paragraph line is unreadable at that
     width. Everything else — directives, the bare table below, images — is
     left at the sheet's full width on purpose. */
  .post__body > :global(p),
  .post__body > :global(ul),
  .post__body > :global(ol),
  .post__body > :global(blockquote) {
    max-width: 68ch;
    margin-block: 22px;
  }

  .post__body > :global(.expressive-code) {
    margin-block: 22px;
  }

  .post__body > :global(h2) {
    max-width: 68ch;
    margin-block: 44px 14px;
    font-size: 30px;
    line-height: 1.2;
    color: var(--ink);
  }

  .post__body > :global(h3) {
    max-width: 68ch;
    margin-block: 32px 12px;
    font-size: 22px;
    line-height: 1.25;
    color: var(--ink);
  }

  /* A bare Markdown table, outside :::ledger. It gets the same treatment as a
     ledger rather than browser defaults — a post should not look broken because
     the author wrote a plain table. */
  .post__body > :global(table) {
    width: 100%;
    margin-block: 30px;
    border-collapse: collapse;
    font-size: 15px;
  }

  .post__body > :global(table) :global(th),
  .post__body > :global(table) :global(td) {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .post__body > :global(table) :global(th) {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* Links in prose are underlined. Colour alone would not distinguish them for
     a reader who cannot see the hue (C3), and body copy is exactly where that
     matters most. */
  .post__body :global(a) {
    color: var(--brand-ink);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* …except a button, which is unmistakably a control already. Without this,
     `.post__body a`'s link colour (two classes deep) outranks `.btn--primary`'s
     single-class white and the label nearly vanishes into its own fill. */
  .post__body :global(tt-button a) {
    color: #ffffff;
    text-decoration: none;
  }

  .post__body :global(strong) { color: var(--ink); }

  .post__body :global(blockquote) {
    margin-inline: 0;
    padding-left: 22px;
    border-left: 3px solid var(--brand);
    color: var(--ink-3);
    font-size: 1.03em;
  }

  @media (max-width: 860px) {
    .post__sheet {
      padding: 34px 24px 44px;
      border-radius: 16px;
    }
  }

  @media (max-width: 700px) {
    .post__body { font-size: 16px; }
    .post__body > :global(h2) { margin-block: 34px 12px; font-size: 25px; }
    .post__body > :global(h3) { font-size: 19px; }
  }
</style>
