---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Drafts are visible in dev, and in a build made with TT_INCLUDE_DRAFTS=1 —
  // which is how gate:directives gets the pipeline fixture into dist/ without
  // ever publishing it.
  const includeDrafts = import.meta.env.DEV || !!import.meta.env.TT_INCLUDE_DRAFTS;
  const posts = await getCollection('posts', ({ data }) => includeDrafts || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title}</title>
    <meta name="description" content={post.data.description} />
    <link rel="alternate" type="text/markdown" href={`/blog/${post.id}.md`} />
  </head>
  <body>
    <main>
      <article>
        <h1>{post.data.title}</h1>
        <Content />
      </article>
    </main>
  </body>
</html>
