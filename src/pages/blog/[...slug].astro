---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Drafts are visible in dev, and in a build made with TT_INCLUDE_DRAFTS=1 —
  // which is how gate:directives gets the pipeline fixture into dist/ without
  // ever publishing it.
  const includeDrafts = import.meta.env.DEV || !!import.meta.env.TT_INCLUDE_DRAFTS;
  const posts = await getCollection('posts', ({ data }) => includeDrafts || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.publishDate;
---

<Base
  title={post.data.title}
  description={post.data.description}
  markdownHref={`/blog/${post.id}.md`}
>
  <article class="post">
    <div class="wrap">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        <time datetime={published.toISOString()}>
          {published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </p>
      <div class="post__body">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post {
    padding-block: var(--sec-y);
  }

  h1 {
    margin-top: 14px;
    font-size: clamp(34px, 5vw, 62px);
    max-width: 18ch;
  }

  .post__meta {
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }

  /* Long-form measure. Everything the Markdown pipeline emits lands here, so
     this is where the reading rhythm is set rather than in each directive. */
  .post__body {
    margin-top: 44px;
    max-width: 68ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .post__body :global(p),
  .post__body :global(ul),
  .post__body :global(ol),
  .post__body :global(table),
  .post__body :global(tt-callout),
  .post__body :global(tt-ledger),
  .post__body :global(tt-steps),
  .post__body :global(tt-stat),
  .post__body :global(.expressive-code) {
    display: block;
    margin-block: 22px;
  }

  .post__body :global(h2) {
    margin-block: 44px 14px;
    font-size: 30px;
    color: var(--ink);
  }

  .post__body :global(h3) {
    margin-block: 32px 12px;
    font-size: 22px;
    color: var(--ink);
  }
</style>
