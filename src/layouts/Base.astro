---
import '../brand/tokens.css';
import '../brand/base.css';
import '../brand/scene.css';
import Constellation from '../components/Constellation.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Raw so it can be inlined in <head>. It must run before the first paint and
// before any stylesheet, which a bundled module script cannot do.
import themeInit from '../brand/theme-init.js?raw';
import { graph, markdownPathFor } from '../lib/seo';

interface Article {
  published: Date;
  updated?: Date;
  section: string;
  tags: string[];
}

interface Props {
  title: string;
  description: string;
  /**
   * Absolute path of the page's Markdown sibling (C1/C4). Every page has one,
   * so this defaults to the path `src/plugins/agents.mjs` writes it at; a post
   * passes its source `.md` explicitly.
   */
  markdownHref?: string;
  /** schema.org nodes for this page; emitted as one `@graph` (C4 contract 4). */
  jsonLd?: object[];
  /** Makes the page `og:type=article` and adds the `article:*` properties. */
  article?: Article;
  /**
   * Site-root path of the share image. `twitter:card` has always claimed
   * `summary_large_image` here; until something fills this in, that claim is a
   * promise of a picture that does not exist and the card renders as a bare
   * link. A post with a hero passes its built src; every other page falls back
   * to the brand card, `/og-default.png`.
   */
  image?: string;
  bodyClass?: string;
  /**
   * For pages that must never be indexed — the 404. Drops the canonical too:
   * a canonical on a not-found page tells a crawler the error IS the page.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  markdownHref: markdownProp,
  jsonLd = [],
  article,
  bodyClass,
  image = '/og-default.png',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const full = title === 'Tamtree' ? title : `${title} · Tamtree`;
const markdownHref = noindex ? undefined : (markdownProp ?? markdownPathFor(Astro.url.pathname));
// `<` escaped so no string in the data can close the script element early.
const ld = jsonLd.length ? JSON.stringify(graph(jsonLd)).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before the stylesheets, deliberately. See theme-init.js. -->
    <script is:inline set:html={themeInit}></script>

    <title>{full}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ea580c" />

    <link rel="alternate" type="application/rss+xml" title="Tamtree blog" href="/blog/rss.xml" />
    <meta property="og:site_name" content="Tamtree" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={(article.updated ?? article.published).toISOString()} />
          <meta property="article:section" content={article.section} />
          {article.tags.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    {/* A data block, not a script: CSP script-src does not apply to it, so the
        strict policy and the theme-init hash are untouched. `is:inline` keeps
        Astro from bundling it out to a file. */}
    {ld && <script type="application/ld+json" is:inline set:html={ld} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Page-specific head tags, e.g. the home page's site verification. -->
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <Constellation />
    <a href="#main" class="skip">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 12px 18px;
        background: var(--brand);
        color: #1a0d03;
        font-weight: 600;
      }

      .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
