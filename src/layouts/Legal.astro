---
import Base from './Base.astro';
import { formatLegalDate, legal } from '../data/legal';

/**
 * The reading sheet for the legal pages — the blog post's sheet, measure and
 * heading rhythm, without the post chrome (category, hero, .md sibling).
 *
 * The section list doubles as an on-page contents block: legal pages are read
 * by jumping to one clause, and platform reviewers (Google, Meta, TikTok) look
 * for specific sections — data deletion, the YouTube disclosures — by name.
 */
interface Props {
  title: string;
  description: string;
  sections: { id: string; title: string }[];
}

const { title, description, sections } = Astro.props;
const updated = legal.lastUpdated;
---

<Base title={title} description={description}>
  <article class="legal">
    <div class="wrap">
      <div class="legal__sheet">
        <p class="eyebrow">Legal</p>
        <h1>{title}</h1>
        <p class="legal__meta">
          Last updated <time datetime={updated}>{formatLegalDate(updated)}</time>
        </p>

        <nav class="legal__toc" aria-labelledby="legal-toc">
          <p class="legal__toc-label" id="legal-toc">On this page</p>
          <ol>
            {sections.map((s) => (
              <li><a href={`#${s.id}`}>{s.title}</a></li>
            ))}
          </ol>
        </nav>

        <div class="legal__body">
          <slot />
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: var(--sec-y);
  }

  /* The blog's opaque sheet: body copy never sits on the moving constellation. */
  .legal__sheet {
    max-width: 1180px;
    margin-inline: auto;
    padding: 56px 88px 68px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--page);
    box-shadow: var(--card-shadow);
  }

  h1 {
    margin-top: 14px;
    font-size: clamp(32px, 4.4vw, 52px);
    max-width: 20ch;
  }

  .legal__meta {
    margin-top: 18px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }

  .legal__toc {
    margin-top: 30px;
    max-width: 68ch;
  }

  .legal__toc-label {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .legal__toc ol {
    margin: 10px 0 0;
    padding-left: 22px;
    columns: 2;
    column-gap: 40px;
    font-size: 15px;
    line-height: 1.9;
  }

  .legal__toc a {
    color: var(--ink-2);
  }

  .legal__toc a:hover {
    color: var(--brand-ink);
  }

  .legal__body {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .legal__body :global(p),
  .legal__body :global(ul),
  .legal__body :global(ol) {
    max-width: 68ch;
    margin-block: 16px;
  }

  .legal__body :global(li + li) {
    margin-top: 6px;
  }

  .legal__body :global(h2) {
    max-width: 68ch;
    margin-block: 44px 12px;
    font-size: 26px;
    line-height: 1.25;
    color: var(--ink);
    /* Clear of the sticky nav when a contents link jumps here. */
    scroll-margin-top: 96px;
  }

  .legal__body :global(h3) {
    max-width: 68ch;
    margin-block: 26px 8px;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
    scroll-margin-top: 96px;
  }

  .legal__body :global(strong) {
    color: var(--ink);
  }

  .legal__body :global(a) {
    color: var(--brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .legal__sheet {
      padding: 36px 22px 44px;
      border-radius: 16px;
    }

    .legal__toc ol {
      columns: 1;
    }

    .legal__body {
      font-size: 16px;
    }

    .legal__body :global(h2) {
      font-size: 22px;
    }
  }
</style>
